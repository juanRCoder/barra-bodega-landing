---
// Página de visualización: Google solo indexa un video cuando es el contenido
// principal de la página (en la landing es solo una sección más).
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/sections/Navbar.astro";
import Footer from "../components/sections/Footer.astro";
import Button from "../components/ui/Button.astro";
import { video, waUrl } from "../data/landing";
---

<Layout
  title={`${video.title} | Video`}
  description={video.description}
  image={video.thumbnail}
  imageAlt={video.title}
  type="article"
>
  <Navbar />
  <main id="inicio" class="bg-green-deep pt-32 pb-20 text-white">
    <article class="container-page">
      <h1 class="mx-auto max-w-240 text-3xl font-semibold tracking-[-0.02em] sm:text-5xl">
        {video.title}
      </h1>
      <p class="mx-auto mt-4 max-w-240 text-lg text-white/80">
        {video.description}
      </p>

      <div class="relative mx-auto mt-10 max-w-240 overflow-hidden rounded-[28px] border border-white/12 bg-green-mid">
        <video
          class="aspect-video w-full bg-green-mid object-cover"
          controls
          preload="metadata"
          playsinline
          poster={video.thumbnail}
          width="1920"
          height="1080"
          aria-label={video.title}
        >
          <source src={video.src} type="video/mp4" />
          Tu navegador no puede reproducir este video.
        </video>
      </div>

      <div class="mx-auto mt-10 flex max-w-240 flex-wrap gap-4">
        <Button href={waUrl()} variant="lime" whatsapp external>
          Prueba gratis 1 mes
        </Button>
        <Button href="/" variant="ghost-light">Ver BarraBodega</Button>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
