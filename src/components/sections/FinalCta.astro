---
import Button from "../ui/Button.astro";
import Check from "../ui/Check.astro";
import { barcodeWidths, waUrl } from "../../data/landing";
---

<section class="container-page">
  <div
    id="cta"
    class="relative grid items-center gap-12 overflow-hidden rounded-[36px] bg-lime px-7 pt-12 pb-16 text-green-deep before:pointer-events-none before:absolute before:-right-30 before:-bottom-40 before:size-105 before:rounded-full before:bg-[radial-gradient(circle,#ffffff8c,transparent_70%)] lg:grid-cols-[1.1fr_0.9fr] lg:px-16 lg:py-18"
  >
    <div class="relative" data-stagger>
      <h2 class="text-[clamp(36px,5vw,60px)] tracking-[-0.045em]">
        ¿Listo para cerrar el cuaderno?
      </h2>
      <p class="mt-4 max-w-[460px] text-lg text-[#2c4a3c]">
        Empieza hoy tu mes gratis. Te ayudamos por WhatsApp a dejar BarraBodega
        lista en tu celular.
      </p>
      <div class="mt-7.5 flex flex-wrap gap-3">
        <Button
          href={waUrl()}
          external
          variant="dark"
          whatsapp
          data-magnetic
          class="max-sm:basis-full"
        >
          Empezar gratis
        </Button>
        <Button href="#precio" variant="ghost-dark" arrow class="max-sm:basis-full">
          Ver precio
        </Button>
      </div>
    </div>

    <div
      id="scanner"
      class="relative w-full max-w-95 rotate-3 justify-self-center rounded-[26px] bg-green-deep px-7.5 pt-8.5 pb-6.5 shadow-float"
      data-reveal="scale"
      aria-hidden="true"
    >
      <div
        class="relative flex h-32.5 justify-center gap-[3px] rounded-[14px] bg-white px-4.5 py-4"
      >
        <span
          class="absolute inset-x-2 top-3 h-0.5 animate-laser rounded-full bg-laser shadow-[0_0_12px_2px_#ff4b3a99,0_0_2px_#ff4b3a]"
        ></span>
        {
          barcodeWidths.map((w) => (
            <i class="block rounded-[1px] bg-green-deep" style={`width: ${w * 2}px`} />
          ))
        }
      </div>
      <div class="mt-3 text-center text-sm tracking-[0.35em] text-mist tabular-nums">
        7 750182 006025
      </div>
      <div
        class="absolute -bottom-5.5 -left-2 flex -rotate-3 animate-toast items-center gap-2.5 rounded-2xl bg-white px-4 py-3 text-sm text-ink shadow-[0_18px_40px_#0b1a1433] sm:-left-7"
      >
        <Check tone="solid" class="size-7.5" />
        <span>
          <strong class="block text-[15px]">Producto agregado</strong>
          <small class="text-muted">Total: S/ 7.00</small>
        </span>
      </div>
    </div>
  </div>
</section>
