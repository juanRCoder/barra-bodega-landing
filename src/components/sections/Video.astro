---
import { getImage } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import posterImage from "../../assets/images/video_poster.jpg";
import { video } from "../../data/landing";

const poster = await getImage({ src: posterImage, width: 1280, format: "webp" });
---

<section id="video" class="bg-green-deep py-20 text-white sm:py-26">
  <div class="container-page">
    <SectionHead
      center
      dark
      eyebrow="Mírala en acción"
      title="Así se vende con BarraBodega"
      text="Un recorrido rápido por la app, de la venta al cierre del día."
    />

    <div
      id="video-frame"
      class="relative mx-auto max-w-240 overflow-hidden rounded-[28px] border border-white/12 bg-green-mid shadow-[0_40px_80px_#00000059]"
    >
      <video
        class="aspect-video w-full bg-green-mid object-cover"
        controls
        preload="metadata"
        playsinline
        poster={poster.src}
        width="1920"
        height="1080"
        aria-label={video.title}
      >
        <source src={video.src} type="video/mp4" />
        Tu navegador no puede reproducir este video.
      </video>
    </div>
  </div>
</section>
