---
import { getImage } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import Check from "../ui/Check.astro";
import posterImage from "../../assets/images/video_poster.jpg";
import { video } from "../../data/landing";

const poster = await getImage({ src: posterImage, width: 1280, format: "webp" });
---

<section id="video" class="bg-green-deep py-20 text-white sm:py-26">
  <div class="container-page">
    <SectionHead
      center
      dark
      eyebrow="Tutorial en video"
      title="Cómo vender en tu bodega con BarraBodega"
      text="Mira en menos de un minuto cómo la app de ventas para bodegas te ayuda a cobrar, controlar fiados e inventario desde el celular."
    />

    <div
      id="video-frame"
      class="relative mx-auto max-w-240 overflow-hidden rounded-[28px] border border-white/12 bg-green-mid shadow-[0_40px_80px_#00000059]"
    >
      <video
        class="aspect-video w-full bg-green-mid object-cover"
        controls
        preload="metadata"
        playsinline
        poster={poster.src}
        width="1920"
        height="1080"
        aria-label={video.title}
      >
        <source src={video.src} type="video/mp4" />
        Tu navegador no puede reproducir este video.
      </video>
    </div>
    <div class="mx-auto mt-10 max-w-240">
      <h3 class="text-xl font-semibold">En este video verás:</h3>
      <ul class="mt-4 grid list-none gap-3 p-0 text-mist sm:grid-cols-2">
        {
          video.highlights.map((item) => (
            <li class="flex items-start gap-3">
              <Check tone="lime" class="mt-0.5 size-5" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
