---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { navLinks, waUrl } from "../../data/landing";

const wa = waUrl();
// Estado sólido del navbar: al bajar del hero (data-scrolled) o con el menú abierto (data-open).
const solid =
  "data-scrolled:bg-paper/92 data-scrolled:text-ink data-scrolled:shadow-[0_1px_0_var(--color-line)] data-scrolled:backdrop-blur-md data-open:bg-paper/92 data-open:text-ink data-open:shadow-[0_1px_0_var(--color-line)] data-open:backdrop-blur-md";
---

<div
  id="progress"
  class="pointer-events-none fixed inset-x-0 top-0 z-70 h-0.75 origin-left scale-x-0 bg-linear-to-r from-green to-lime motion-reduce:hidden"
  aria-hidden="true"
>
</div>

<header
  id="nav"
  class:list={[
    "group/nav fixed inset-x-0 top-0 z-50 text-white transition-[background-color,color,box-shadow] duration-400 ease-soft",
    solid,
  ]}
>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a
      class="group/brand inline-flex items-center gap-2.5 text-[19px] font-semibold tracking-[-0.02em] no-underline"
      href="/#inicio"
      aria-label="BarraBodega, ir al inicio"
    >
      <span
        class="grid size-9 place-items-center rounded-[10px] bg-lime text-green-dark transition-[rotate] duration-500 ease-out-quint group-hover/brand:-rotate-8"
      >
        <Icon name="barcode" class="size-5" />
      </span>
      BarraBodega
    </a>

    <nav aria-label="Principal">
      <ul
        id="nav-links"
        class="m-0 hidden list-none items-center gap-7.5 p-0 lg:flex max-lg:group-data-open/nav:absolute max-lg:group-data-open/nav:inset-x-0 max-lg:group-data-open/nav:top-18 max-lg:group-data-open/nav:grid max-lg:group-data-open/nav:border-b max-lg:group-data-open/nav:border-line max-lg:group-data-open/nav:bg-paper max-lg:group-data-open/nav:px-5 max-lg:group-data-open/nav:pt-2 max-lg:group-data-open/nav:pb-5"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="relative text-[15px] font-medium no-underline opacity-78 transition-opacity hover:opacity-100 max-lg:block max-lg:border-b max-lg:border-line max-lg:py-3.5 max-lg:text-[17px] max-lg:opacity-100 lg:after:absolute lg:after:inset-x-0 lg:after:-bottom-1.5 lg:after:h-0.5 lg:after:origin-left lg:after:scale-x-0 lg:after:rounded-full lg:after:bg-current lg:after:transition-transform lg:after:duration-300 lg:after:ease-out-quint lg:hover:after:scale-x-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="mt-3 lg:hidden">
          <Button href={wa} external class="flex w-full">Probar gratis 1 mes</Button>
        </li>
      </ul>
    </nav>

    <Button href={wa} external variant="lime" size="sm" class="max-lg:hidden">
      Probar gratis
    </Button>

    <button
      id="menu-toggle"
      class="grid size-11 cursor-pointer place-items-center rounded-xl lg:hidden"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <Icon name="menu" class="size-6" />
    </button>
  </div>
</header>

<script>
  const nav = document.getElementById("nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const hero = document.getElementById("hero");

  // Transparente sobre el hero, sólida al bajar.
  const onScroll = () =>
    nav.toggleAttribute(
      "data-scrolled",
      window.scrollY > (hero ? hero.offsetHeight - 90 : 10),
    );
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    nav.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  toggle.addEventListener("click", () => setMenu(!nav.hasAttribute("data-open")));
  document
    .querySelectorAll("#nav-links a")
    .forEach((link) => link.addEventListener("click", () => setMenu(false)));
</script>
