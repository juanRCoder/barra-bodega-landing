---
import { marqueeItems } from "../../data/landing";
---

<div
  class="group overflow-hidden bg-lime py-5.5 text-green-deep"
  aria-label="Lo que hace BarraBodega"
>
  <div
    class="flex w-max animate-marquee group-hover:[animation-play-state:paused]"
  >
    {
      [false, true].map((hidden) => (
        <ul
          class="m-0 flex list-none gap-12 px-6 py-0 text-[17px] font-semibold whitespace-nowrap"
          aria-hidden={hidden ? "true" : undefined}
        >
          {marqueeItems.map((item) => (
            <li class="inline-flex items-center gap-12 after:size-2 after:rounded-full after:bg-green">
              {item}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
