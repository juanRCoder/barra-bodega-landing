---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  center?: boolean;
  dark?: boolean;
}

const { eyebrow, title, text, center = false, dark = false } = Astro.props;
---

<div
  class:list={["mb-13 max-w-[660px]", center && "mx-auto text-center"]}
  data-stagger
>
  <Eyebrow dark={dark}>{eyebrow}</Eyebrow>
  <h2 class="mt-3.5 text-[clamp(32px,4.6vw,50px)]">{title}</h2>
  {
    text && (
      <p class:list={["mt-3.5 text-lg", dark ? "text-mist" : "text-muted"]}>
        {text}
      </p>
    )
  }
</div>
