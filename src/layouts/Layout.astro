---
import SEO from "../components/SEO.astro";
import IconSprite from "../components/IconSprite.astro";
import { site } from "../config/site";
import { plans, video } from "../data/landing";
import logoImage from "../assets/logo.webp";
import "../styles/global.css";

type Props = import("../components/SEO.astro").Props;

const siteUrl = Astro.site!.href;
const abs = (path: string) => new URL(path, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: site.name,
      alternateName: site.altername,
      url: siteUrl,
      inLanguage: site.lang,
      publisher: { "@id": `${siteUrl}#business` },
    },
    {
      "@type": "SoftwareApplication",
      name: site.name,
      description: site.description,
      url: siteUrl,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Android",
      offers: Object.values(plans).map((plan) => ({
        "@type": "Offer",
        name: plan.name,
        price: plan.amount.toFixed(2),
        priceCurrency: "PEN",
      })),
    },
    {
      "@type": "VideoObject",
      name: video.title,
      description: video.description,
      thumbnailUrl: abs(video.thumbnail),
      uploadDate: video.uploadDate,
      duration: video.duration,
      contentUrl: abs(video.src),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(() => {
        const root = document.documentElement;
        if (!root.classList.contains("motion-ready"))
          root.classList.add("motion-off");
      }, 4000);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO {...Astro.props} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <IconSprite />
    <slot />
  </body>
</html>
